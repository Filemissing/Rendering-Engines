#version 430 core

layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(rgba32f, binding = 0) uniform writeonly image3D seedOut;
layout(r8, binding = 1) uniform writeonly image3D signOut;



// world bounds
uniform vec3 _WorldMin;
uniform vec3 _WorldMax;
uniform vec3 _Resolution;

// terrain uniforms
uniform int _Octaves;
uniform float _WarpStrength;
uniform float _Lacunarity;
uniform float _Persistence;
uniform float _HeightScale;

// -- Objects --
#define MAX_PRIMITIVES 64
#define TYPE_SPHERE    0
#define TYPE_BOX       1
#define TYPE_PYRAMID   2
#define TYPE_CAPSULE   3
#define TYPE_CYLINDER  4
#define TYPE_TORUS     5
#define TYPE_CONE      6
#define TYPE_PLANE     7
#define TYPE_TERRAIN   8

layout(std430, binding = 0) readonly buffer PrimitiveBuffer {
    Primitive primitives[];
};

struct Primitive {
    int   type;
    vec3  position;
    vec3  rotation;
    vec3  scale;
    vec3  data;
    vec3  color;
};

//uniform Primitive primitives[MAX_PRIMITIVES];
uniform int primitiveCount;

// ----------------------------------------------------------------
// SDF primitives
// ----------------------------------------------------------------
float SphereSDF(vec3 p, vec3 center, float radius) {
    return length(p - center) - radius;
}

float BoxSDF(vec3 p, vec3 center, vec3 data) {
    vec3 q = abs(p - center) - data;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float PyramidSDF(vec3 p, float height, float baseHalfSize) {
    // Fold into the first quadrant — pyramid is 4-fold symmetric
    p.xz = abs(p.xz);

    // Slope of the face
    float slope = baseHalfSize / height;

    // Distance to the slanted face
    float face = p.y * slope + p.x + p.z - baseHalfSize;
    if (p.x < p.z) face = p.y * slope + p.z + p.x - baseHalfSize;

    // Clamp to pyramid region
    float d = max(face * inversesqrt(slope * slope + 2.0),
    -p.y);              // bottom cap
    d = max(d, p.y - height);        // top cap

    return d;
}
// Capsule — data.x = radius, data.y = half length (along Y axis)
float CapsuleSDF(vec3 p, float radius, float halfLen) {
    p.y -= clamp(p.y, -halfLen, halfLen);
    return length(p) - radius;
}

// Cylinder — data.x = radius, data.y = half height
float CylinderSDF(vec3 p, float radius, float halfHeight) {
    vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(radius, halfHeight);
    return min(max(d.x, d.y), 0.0) + length(max(d, 0.0));
}

// Torus — data.x = major radius (ring), data.y = minor radius (tube)
float TorusSDF(vec3 p, float major, float minor) {
    vec2 q = vec2(length(p.xz) - major, p.y);
    return length(q) - minor;
}

// Cone — data.x = base radius, data.y = height (apex at +Y, base at -Y)
float ConeSDF(vec3 p, float radius, float height) {
    p.y -= height * 0.5;
    vec2 q = vec2(length(p.xz), -p.y);
    vec2 tip = vec2(radius, height);
    vec2 a = q - tip * clamp(dot(q, tip) / dot(tip, tip), 0.0, 1.0);
    vec2 b = q - tip * vec2(clamp(q.x / tip.x, 0.0, 1.0), 1.0);
    float s = sign(tip.y * q.x - tip.x * q.y);
    float d = min(dot(a, a), dot(b, b));
    return sqrt(d) * sign(max(s, -sign(p.y + height * 0.5)));
}

// Infinite plane — data.xyz = normal, data.w would be offset
// Since we only have vec3, pass normal in data and offset in scale.x
float PlaneSDF(vec3 p, vec3 normal, float offset) {
    return dot(p, normalize(normal)) - offset;
}

// Terrain generation
float hash2D(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}
vec3 hash3D(vec3 p) {
    p = fract(p * vec3(123.34, 456.21, 789.12));
    p += dot(p, p + 45.32);
    return fract(vec3(p.x * p.y, p.y * p.z, p.z * p.x));
}

float smoothNoise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);

    // Sample 8 corners of the 3D voxel cell using component .x of hash3D
    float a = hash3D(i + vec3(0.0,0.0,0.0)).x;
    float b = hash3D(i + vec3(1.0,0.0,0.0)).x;
    float c = hash3D(i + vec3(0.0,1.0,0.0)).x;
    float d = hash3D(i + vec3(1.0,1.0,0.0)).x;
    float e = hash3D(i + vec3(0.0,0.0,1.0)).x;
    float g = hash3D(i + vec3(1.0,0.0,1.0)).x;
    float h = hash3D(i + vec3(0.0,1.0,1.0)).x;
    float j = hash3D(i + vec3(1.0,1.0,1.0)).x;

    return mix(mix(mix(a, b, u.x), mix(c, d, u.x), u.y),
    mix(mix(e, g, u.x), mix(h, j, u.x), u.y), u.z);
}
vec3 warp(vec3 p, float warp_amplitude) {
    float ox = smoothNoise3D(p);
    float oy = smoothNoise3D(p + vec3(31.41, 15.92, 65.35));
    float oz = smoothNoise3D(p + vec3(89.79, 32.38, 46.26));

    vec3 offset = vec3(ox, oy, oz) * 2.0 - 1.0;

    // scale down vertical impact
    offset.y *= 0.3;

    return p + offset * warp_amplitude;
}

float valueNoise2D(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    float a = hash2D(i);
    float b = hash2D(i + vec2(1.0, 0.0));
    float c = hash2D(i + vec2(0.0, 1.0));
    float d = hash2D(i + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p, int octaves, float lucanarity, float persistence) {
    float value = 0.0;
    float amplitude = 0.5;
    float frequency = 1.0;
    for (int i = 0; i < octaves; i++) {
        value += amplitude * valueNoise2D(p * frequency);
        frequency *= lucanarity;
        amplitude *= persistence;
    }
    return value;
}

float pattern(vec3 point, int octaves, float lucanarity, float persistence, float warpStrength) {
    // Warp the point in space
    vec3 p = warp(point, warpStrength);

    vec2 q = vec2(fbm(p.xz + vec2(0.0,0.0), octaves, lucanarity, persistence),
    fbm(p.xz + vec2(5.2,1.3), octaves, lucanarity, persistence));

    vec2 r = vec2(fbm(p.xz + 4.0 * q + vec2(1.7,9.2), octaves, lucanarity, persistence),
    fbm(p.xz + 4.0 * q + vec2(8.3,2.8), octaves, lucanarity, persistence));

    // Calculate base height
    float baseHeight = fbm(p.xz + 4.0 * r, octaves, lucanarity, persistence);

    return baseHeight + (point.y - p.y);
}

float TerrainSDF(vec3 p, int octaves, float heightScale, float lacunarity, float persistence) {
    float h = pattern(p * 0.1, octaves, lacunarity, persistence, _WarpStrength) * heightScale;

    return p.y - h;
}

// ----------------------------------------------------------------
// Scene definition
// ----------------------------------------------------------------
struct Hit {
    float dist;
    int   id;   // which object was hit (for colouring)
};

mat3 eulerToMat3(vec3 euler) {
    float cx = cos(euler.x), sx = sin(euler.x);
    float cy = cos(euler.y), sy = sin(euler.y);
    float cz = cos(euler.z), sz = sin(euler.z);

    // ZYX order — most common convention (matches GLM default)
    mat3 rx = mat3(
    1,   0,   0,
    0,  cx, -sx,
    0,  sx,  cx
    );
    mat3 ry = mat3(
    cy,  0,  sy,
    0,  1,   0,
    -sy,  0,  cy
    );
    mat3 rz = mat3(
    cz, -sz,  0,
    sz,  cz,  0,
    0,   0,  1
    );

    return rz * ry * rx;
}

Hit mapScene(vec3 p) {
    Hit h;
    h.dist = 1e9;
    h.id   = -1;

    for (int i = 0; i < primitiveCount; i++) {
        float d;
        vec3 localP = eulerToMat3(primitives[i].rotation) * (p - primitives[i].position);
        localP /= primitives[i].scale; // apply scale

        if (primitives[i].type == TYPE_SPHERE) {
            d = SphereSDF(localP, vec3(0.0), primitives[i].data.x);
            d *= min(primitives[i].scale.x,
            min(primitives[i].scale.y, primitives[i].scale.z));
        }
        else if (primitives[i].type == TYPE_BOX) {
            d = BoxSDF(localP, vec3(0.0), primitives[i].data);
            d *= min(primitives[i].scale.x,
            min(primitives[i].scale.y, primitives[i].scale.z));
        }
        else if (primitives[i].type == TYPE_PYRAMID) {
            d = PyramidSDF(localP, primitives[i].data.y, primitives[i].data.x);
            d *= min(primitives[i].scale.x,
            min(primitives[i].scale.y, primitives[i].scale.z));
        }
        else if (primitives[i].type == TYPE_CAPSULE) {
            d = CapsuleSDF(localP,
            primitives[i].data.x,
            primitives[i].data.y);
            d *= min(primitives[i].scale.x,
            min(primitives[i].scale.y, primitives[i].scale.z));
        }
        else if (primitives[i].type == TYPE_CYLINDER) {
            d = CylinderSDF(localP,
            primitives[i].data.x,
            primitives[i].data.y);
            d *= min(primitives[i].scale.x,
            min(primitives[i].scale.y, primitives[i].scale.z));
        }
        else if (primitives[i].type == TYPE_TORUS) {
            d = TorusSDF(localP,
            primitives[i].data.x,
            primitives[i].data.y);
            d *= min(primitives[i].scale.x,
            min(primitives[i].scale.y, primitives[i].scale.z));
        }
        else if (primitives[i].type == TYPE_CONE) {
            d = ConeSDF(localP,
            primitives[i].data.x,
            primitives[i].data.y);
            d *= min(primitives[i].scale.x,
            min(primitives[i].scale.y, primitives[i].scale.z));
        }
        else if (primitives[i].type == TYPE_PLANE) {
            d = PlaneSDF(localP,
            primitives[i].data,
            primitives[i].scale.x);
        }
        else if (primitives[i].type == TYPE_TERRAIN) {
            d = TerrainSDF(localP, _Octaves, _HeightScale, _Lacunarity, _Persistence);
        }
        else {
            d = -999; // no-primitive type matched
        }

        if (d < h.dist) {
            h.dist = d;
            h.id   = i; // use index directly - look up color from array
        }
    }

    return h;
}

void main() {
    ivec3 texel = ivec3(gl_GlobalInvocationID);

    vec3 uvw = (vec3(texel) + 0.5) / vec3(_Resolution);
    vec3 worldPos = _WorldMin + uvw * (_WorldMax - _WorldMin);
    float voxelSize = length((_WorldMax - _WorldMin) / _Resolution); // gets the maximum size of a voxel (corner to corner)

    Hit h = mapScene(worldPos);
    float m_sign = (h.dist <= 0.0) ? 1.0 : 0.0;             // every voxel gets this
    float isSeed = (abs(h.dist) < voxelSize) ? 1.0 : 0.0; // only near-surface voxels

    vec3 refinedTexel = vec3(texel); // fallback stays, but should rarely trigger now

    if (isSeed > 0.5) {
        float eps = voxelSize * 0.25;

        float dx = mapScene(worldPos + vec3(eps,0,0)).dist - mapScene(worldPos - vec3(eps,0,0)).dist;
        float dy = mapScene(worldPos + vec3(0,eps,0)).dist - mapScene(worldPos - vec3(0,eps,0)).dist;
        float dz = mapScene(worldPos + vec3(0,0,eps)).dist - mapScene(worldPos - vec3(0,0,eps)).dist;
        vec3 grad = vec3(dx, dy, dz);

        if (length(grad) > 1e-6) {
            vec3 gradN = normalize(grad);
            vec3 surfaceWorldPos = worldPos - h.dist * gradN; // walk back along the gradient to the zero-crossing

            vec3 surfaceUvw = (surfaceWorldPos - _WorldMin) / (_WorldMax - _WorldMin);
            refinedTexel = surfaceUvw * vec3(_Resolution) - 0.5;
        }
    }

    imageStore(seedOut, texel, vec4(refinedTexel, isSeed));
    imageStore(signOut, texel, vec4(m_sign));
}