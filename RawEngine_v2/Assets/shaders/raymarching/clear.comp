#version 430 core
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(r8, binding = 0) uniform writeonly image3D brickActiveOut;

uniform vec3 _GridResolution;

void main() {
    ivec3 brickIndex = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(brickIndex, ivec3(_GridResolution)))) return;
    imageStore(brickActiveOut, brickIndex, vec4(0.0));
}